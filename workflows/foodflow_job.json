{
  "name": "FoodFlow_Pipeline",
  "email_notifications": {
    "on_success": [
      "<your-email>"
    ],
    "on_failure": [
      "<your-email>"
    ],
    "no_alert_for_skipped_runs": false
  },
  "notification_settings": {
    "no_alert_for_skipped_runs": false,
    "no_alert_for_canceled_runs": false
  },
  "timeout_seconds": 0,
  "schedule": {
    "quartz_cron_expression": "30 3 2 * * ?",
    "timezone_id": "America/Los_Angeles",
    "pause_status": "UNPAUSED"
  },
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "run_pipeline",
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<your-user>/FoodFlow_pipeline",
        "source": "WORKSPACE"
      },
      "max_retries": 2,
      "min_retry_interval_millis": 300000,
      "retry_on_timeout": false,
      "timeout_seconds": 0
    }
  ],
  "queue": {
    "enabled": true
  },
  "performance_target": "PERFORMANCE_OPTIMIZED"
}
